# Supabase (optional for local dev; required in production for accounts + problems).

# Public — safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only, NEVER prefix with NEXT_PUBLIC. Used by the /api routes
# to read the locked-down problems table. Get it from Supabase →
# Project Settings → API → service_role (secret) key.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay subscriptions (server only). Until all three of the first three are set, nothing is locked.
# Key id/secret: Razorpay Dashboard → Account & Settings → API Keys.
# Plan id: Dashboard → Subscriptions → Plans → a ₹1,499 monthly plan (plan_...).
# Webhook secret: the secret you type when adding the webhook (see DEPLOY.md).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
